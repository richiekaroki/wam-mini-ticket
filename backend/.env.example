PORT=3000
# Frontend origin allowed by CORS (must match where the UI runs)
CORS_ORIGIN=http://localhost:5173
# Replace with your Neon PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&channel_binding=require
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@ep-REPLACE_ME.neo.tech/neondb?sslmode=verify-full&channel_binding=require